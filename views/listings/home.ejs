<% layout("/layouts/boilerplate") %>
<body>

  <!-- Hero Section -->
  <header class="hero text-center text-white py-5" style="background: url('https://plus.unsplash.com/premium_photo-1681149342561-96713cd1728a?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8NXx8eWVsbG93JTIwdHJhdmVsfGVufDB8fDB8fHww') center/cover no-repeat; filter: brightness(0.8);">
    <div class="container">
      <h1 class="display-3 fw-bold text-shadow">Welcome to Nestly</h1>
      <p class="lead">Your gateway to unforgettable stays and adventures worldwide.</p>
      <a href="/listings" class="btn btn-danger btn-lg mt-3">Find Your Stay</a>
    </div>
  </header>

  <!-- About Section -->
  <section class="about py-5 bg-white">
    <div class="container">
      <h2 class="text-center mb-4 text-danger">Why Choose Nestly?</h2>
      <div class="row">
        <div class="col-md-4 text-center">
          <img src="https://source.unsplash.com/96x96/?unique-destinations" alt="Travel" class="mb-3 rounded-circle border border-danger p-2">
          <h5 class="text-danger">Unique Destinations</h5>
          <p>Explore hidden gems and unique stays tailored for your next adventure.</p>
        </div>
        <div class="col-md-4 text-center">
          <img src="https://source.unsplash.com/96x96/?customer-support" alt="Support" class="mb-3 rounded-circle border border-danger p-2">
          <h5 class="text-danger">24/7 Support</h5>
          <p>Our team is here to help you anytime, ensuring a hassle-free experience.</p>
        </div>
        <div class="col-md-4 text-center">
          <img src="https://source.unsplash.com/96x96/?affordable-price" alt="Affordable" class="mb-3 rounded-circle border border-danger p-2">
          <h5 class="text-danger">Affordable Prices</h5>
          <p>Get the best deals on stays without compromising quality.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="cta text-center py-5 bg-danger text-white">
    <div class="container">
      <h2>Ready to explore the world?</h2>
      <p>Find your perfect stay with Nestly and start your journey today.</p>
      <a href="/listings" class="btn btn-light btn-lg mt-3">Browse Listings</a>
    </div>
  </section>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>


</body>
