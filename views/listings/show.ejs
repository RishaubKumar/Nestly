<!-- Renders the detailed view of a property listing, handles bookings, and displays/creates reviews -->

<% layout("/layouts/boilerplate") %>

<%
  let avgRating = 0;
  if (listing.reviews && listing.reviews.length > 0) {
    let sum = 0;
    listing.reviews.forEach(review => { sum += review.rating; });
    avgRating = sum / listing.reviews.length;
    avgRating = Math.round(avgRating * 10) / 10;
  }
  let nightlyPrice = Math.round((listing.price / 30) * 3);
%>

<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <h2><%= listing.title %></h2>
      <p class="text-muted">
        <i class="bi bi-geo-alt-fill text-danger"></i>
        <% if (currUser) { %>
          <%= listing.location %>, <%= listing.country %>
        <% } else { %>
          <span class="text-danger fw-bold">Log in to view exact location</span>, <%= listing.country %>
        <% } %>
      </p>
    </div>
  </div>

  <div class="row text-muted">
    <div class="col-md-8">
      <div class="mb-4">
        <% const coverImage = (listing.images && listing.images.length > 0) ? listing.images[0].url : '/images/default.jpg'; %>
        <img id="coverImage" src="<%= coverImage %>" class="img-fluid rounded mb-2" alt="<%= listing.title %>" style="height: 350px; width: 100%; object-fit: cover;">
        
        <% if (currUser && listing.images && listing.images.length > 1) { %>
          <div class="mb-3">
            <div class="row g-2">
              <% listing.images.forEach((img, idx) => { %>
                <div class="col-3">
                  <img src="<%= img.url %>" class="img-thumbnail img-fluid rounded" style="height: 80px; width: 100%; object-fit: cover; cursor: pointer;" onclick="document.getElementById('coverImage').src = '<%= img.url %>'">
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <div class="mt-3">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <span class="badge bg-danger fs-6"><%= listing.rentalOption.toUpperCase() %></span>
              <p class="mt-2 mb-0 text-dark"><strong>Hosted By:</strong> <i><%= listing.owner.username %></i></p>
            </div>
            <h4 class="text-danger fw-bold">&#8377; <%= listing.price.toLocaleString("en-IN") %> / month</h4>
          </div>
          <hr>
          <p class="card-text text-dark"><%= listing.description %></p>
        </div>
      </div>

      <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
        <div class="mb-4">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark me-2">Edit Listing</a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
            <button class="btn btn-danger">Delete Listing</button>
          </form>
        </div>
      <% } %>

      <% if (currUser) { %>
        <% if (listing.amenities && listing.amenities.length > 0) { %>
          <div class="mb-4 text-dark">
            <h5>What this place offers</h5>
            <div class="row">
              <% listing.amenities.forEach((amenity) => { %>
                <div class="col-md-6 mb-2">
                  <i class="bi bi-check-circle-fill text-success me-2"></i><%= amenity %>
                </div>
              <% }); %>
            </div>
          </div>
          <hr>
        <% } %>
      <% } else { %>
        <div class="mb-4">
          <h5 class="text-dark">What this place offers</h5>
          <p class="text-muted small"><i class="bi bi-shield-lock me-1"></i>Please <a href="/login" class="text-danger">login</a> to view full amenities details.</p>
        </div>
        <hr>
      <% } %>

      <div class="mb-4">
        <% if (currUser) { %>
          <h5 class="text-dark">Leave a Review</h5>
          <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation mb-4 text-dark">
            <div class="mb-3">
              <label for="rating" class="form-label">Rating</label>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            <div class="mb-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea name="review[comment]" id="comment" cols="30" rows="3" class="form-control" required></textarea>
              <div class="invalid-feedback">Please leave a comment!</div>
            </div>
            <button class="btn btn-outline-dark btn-sm">Submit Review</button>
          </form>
        <% } %>

        <h5 class="text-dark">All Reviews (<%= listing.reviews ? listing.reviews.length : 0 %>)</h5>
        <% if (currUser) { %>
          <% if (listing.reviews && listing.reviews.length > 0) { %>
            <div class="row">
              <% listing.reviews.forEach((review) => { %>
                <div class="col-md-6 mb-3">
                  <div class="card p-3 shadow-sm border-0 bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <strong class="text-dark"><%= review.author.username %></strong>
                      <div>
                        <% for(let i = 1; i <= 5; i++) { %>
                          <i class="bi bi-star<%= i <= review.rating ? '-fill' : '' %> text-warning"></i>
                        <% } %>
                      </div>
                    </div>
                    <p class="card-text text-muted mb-2"><%= review.comment %></p>
                    <% if (currUser._id.equals(review.author._id) || currUser._id.equals(listing.owner._id)) { %>
                      <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="m-0">
                        <button class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.8rem;">Delete</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="text-muted">No reviews yet.</p>
          <% } %>
        <% } else { %>
          <p class="text-muted small"><i class="bi bi-shield-lock me-1"></i>Please <a href="/login" class="text-danger">login</a> to read guest reviews.</p>
        <% } %>
      </div>
    </div>

    <div class="col-md-4">
      <div class="p-3 bg-light rounded mb-4 text-dark">
        <% if (!currUser) { %>
          <div class="text-center py-3">
            <i class="bi bi-lock text-danger fs-1"></i>
            <h5 class="mt-3">Interested in this stay?</h5>
            <p class="text-muted small">Please log in or sign up to book this property or send a rental inquiry.</p>
            <div class="d-grid gap-2 mt-3">
              <a href="/login" class="btn btn-danger btn-sm fw-bold">Login to Book</a>
              <a href="/signup" class="btn btn-outline-danger btn-sm fw-bold">Sign Up Now</a>
            </div>
          </div>
        <% } else { %>
          <% if (listing.rentalOption === 'both') { %>
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" role="switch" id="bookingToggle">
              <label class="form-check-label fw-bold" for="bookingToggle" id="toggleLabel">Rent this property</label>
            </div>
          <% } %>

          <!-- Rent Form -->
          <div id="rentFormSection" class="<%= (listing.rentalOption === 'booking') ? 'd-none' : '' %>">
            <h5 class="card-title text-danger fw-bold">&#8377; <%= listing.price.toLocaleString("en-IN") %> <span class="fs-6 text-muted fw-normal">/ month</span></h5>
            <form action="/bookings" method="POST" class="mt-3">
              <input type="hidden" name="listingId" value="<%= listing._id %>">
              <div class="mb-3">
                <label class="form-label small fw-bold">Move-in Date</label>
                <input type="date" name="startDate" class="form-control form-control-sm" required>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Duration (Months)</label>
                <input type="number" name="durationInMonths" class="form-control form-control-sm" min="1" required>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Full Name</label>
                <input type="text" name="fullName" class="form-control form-control-sm" value="<%= currUser.username %>" required>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Phone Number</label>
                <input type="tel" name="phone" class="form-control form-control-sm" required>
              </div>
              <button class="btn btn-danger w-100 fw-bold btn-sm">Send Rental Inquiry</button>
            </form>
          </div>

          <!-- Booking Form -->
          <div id="bookingFormSection" class="<%= (listing.rentalOption !== 'booking') ? 'd-none' : '' %>">
            <h5 class="card-title text-danger fw-bold">&#8377; <%= nightlyPrice.toLocaleString("en-IN") %> <span class="fs-6 text-muted fw-normal">/ night</span></h5>
            <form action="/bookings" method="POST" class="mt-3">
              <input type="hidden" name="listingId" value="<%= listing._id %>">
              <div class="mb-3">
                <label class="form-label small fw-bold">Check-in Date</label>
                <input type="date" name="checkin" class="form-control form-control-sm" required>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Check-out Date</label>
                <input type="date" name="checkout" class="form-control form-control-sm" required>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Guests</label>
                <input type="number" name="guests" class="form-control form-control-sm" min="1" max="10" required>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Full Name</label>
                <input type="text" name="fullName" class="form-control form-control-sm" value="<%= currUser.username %>" required>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Phone Number</label>
                <input type="tel" name="phone" class="form-control form-control-sm" required>
              </div>
              <button class="btn btn-danger w-100 fw-bold btn-sm">Book Stay</button>
            </form>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('bookingToggle');
    if (toggle) {
      toggle.addEventListener('change', function() {
        const rentForm = document.getElementById('rentFormSection');
        const bookingForm = document.getElementById('bookingFormSection');
        const label = document.getElementById('toggleLabel');
        if (this.checked) {
          rentForm.classList.add('d-none');
          bookingForm.classList.remove('d-none');
          label.textContent = "Book stays daily";
        } else {
          rentForm.classList.remove('d-none');
          bookingForm.classList.add('d-none');
          label.textContent = "Rent this property";
        }
      });
    }
  });
</script>