<% layout("/layouts/boilerplate") %>

<%
  // Compute overall average rating from all reviews
  let avgRating = 0;
  if (listing.reviews && listing.reviews.length > 0) {
    let sum = 0;
    listing.reviews.forEach(review => { sum += review.rating; });
    avgRating = sum / listing.reviews.length;
    avgRating = Math.round(avgRating * 10) / 10; // round to one decimal place
  }
%>

<div class="container p-2">
  <!-- Title and Location -->
  <div class="row mb-3">
    <div class="col-12">
      <h3 class="mt-2 text-start"><%= listing.title %></h3>
      <p class="card-text mb-1">
        <strong>Location:</strong>
        <a 
          href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(listing.location + ', ' + listing.country) %>"
          target="_blank"
        >
          <%= listing.location %>, <%= listing.country %>
        </a>
      </p>
    </div>
  </div>

  <!-- Images Section -->
  <div class="row">
    <div class="col-12">
      <div class="card listing-card" style="width: 100%;">
        <% 
          // The first image is used as the cover image
          const coverImage = (listing.images && listing.images.length > 0) 
            ? listing.images[0].url 
            : '/images/default.jpg';
          // The rest of the images (if any) become the gallery
          const galleryImages = (listing.images && listing.images.length > 1)
            ? listing.images.slice(1) 
            : [];
        %>

        <!-- Cover Image -->
        <div style="border: 1px solid #ddd; padding: 5px; max-height: 450px; margin-bottom: 15px;">
          <img 
            id="coverImage"
            src="<%= coverImage %>"
            alt="Cover Image"
            style="object-fit: cover; width: 100%; max-height: 450px;"
          >
        </div>

        <!-- Thumbnail Gallery (if more images exist) -->
        <% if (galleryImages.length > 0) { %>
          <div class="row">
            <% galleryImages.forEach((img, index) => { %>
              <div class="col-md-3 col-6 mb-3">
                <img 
                  src="<%= img.url %>"
                  alt="Gallery image <%= index + 1 %>"
                  style="object-fit: cover; width: 100%; height: 150px; cursor: pointer;"
                  onclick="document.getElementById('coverImage').src = '<%= img.url %>'"
                >
              </div>
            <% }) %>
          </div>
        <% } %>

        <div class="card-body p-3">
          <p class="card-text mb-1">
            <strong>Overall Rating:</strong> <%= avgRating %> / 5 (<%= listing.reviews ? listing.reviews.length : 0 %> reviews)
          </p>
          <p class="card-text mb-1">
            <strong>Owned By:</strong> <i><%= listing.owner.username %></i>
          </p>
          <p class="card-text mb-1"><%= listing.description %></p>
          <p class="card-text mb-1">
            <strong>Price:</strong> &#8377;<%= listing.price.toLocaleString("en-IN") %>
          </p>
        </div>
      </div>

      <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
        <div class="text-center mt-3">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark me-2">Edit</a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
            <button class="btn btn-danger">Delete</button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <!-- "What This Place Offers" Section -->
  <% if (listing.amenities && listing.amenities.length > 0) { %>
    <div class="mt-4 mb-5">
      <h4>What this place offers</h4>
      <ul class="list-unstyled d-flex flex-wrap" style="gap: 20px;">
        <% listing.amenities.forEach(amenity => { %>
          <li style="min-width: 120px;">
            <i class="bi bi-check-circle-fill text-success me-1"></i>
            <%= amenity %>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <!-- Reviews & Booking Section -->
  <div class="row">
    <!-- Reviews Column -->
    <div class="col-md-8 mb-5">
      <% if (currUser) { %>
        <h4 class="mb-3">Leave a Review</h4>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation mb-5">
          <!-- Rating Field -->
          <div class="mb-3">
            <label for="rating" class="form-label">Rating</label>
            <fieldset class="starability-slot">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>
          <!-- Comment Field -->
          <div class="mb-3">
            <label for="comment" class="form-label">Comment</label>
            <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" required></textarea>
            <div class="invalid-feedback">Please leave some comment!</div>
          </div>
          <button class="btn btn-outline-dark">Submit</button>
        </form>
      <% } %>

      <!-- All Reviews -->
      <h4 class="mb-3">All Reviews</h4>
      <div class="row">
        <% listing.reviews.forEach(review => { %>
          <div class="card col-5 ms-3 mb-3 p-0">
            <div class="card-body p-3">
              <h5 class="card-title"><%= review.author.username %></h5>
              <p class="starability-result mb-1" data-rating="<%= review.rating %>"></p>
              <p class="card-text mb-1"><%= review.comment %></p>
              <p class="card-text"><%= review.rating %> Stars</p>
              <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="mb-0">
                <button class="btn btn-sm btn-danger">Delete</button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Booking Column -->
    <div class="col-md-4">
      <div class="card shadow-sm p-3">
        <div class="card-body p-3">
          <h4 class="fw-bold">Rent this place</h4>
          <p>
            <strong>Price:</strong> &#8377;<%= listing.price.toLocaleString("en-IN") %> / month
          </p>
          <form action="/user/dashboard" method="POST">
            <input type="hidden" name="listingId" value="<%= listing._id %>">
            
            <!-- Expected Move-in Date -->
            <div class="mb-3">
              <label for="startDate" class="form-label">Expected Move-in Date</label>
              <input type="date" name="startDate" class="form-control" required>
            </div>
            
            <!-- Duration in Months -->
            <div class="mb-3">
              <label for="durationInMonths" class="form-label">Duration (in months)</label>
              <input type="number" name="durationInMonths" class="form-control" min="1" required>
            </div>
            
            <!-- Full Name (Auto-filled) -->
            <div class="mb-3">
              <label for="fullName" class="form-label">Your Full Name</label>
              <input type="text" name="fullName" class="form-control" value="<%= currUser ? currUser.username : '' %>" readonly required>
            </div>
            
            <!-- Phone Number -->
            <div class="mb-3">
              <label for="phone" class="form-label">Phone Number</label>
              <input type="tel" name="phone" class="form-control" required>
            </div>
            
            <button type="submit" class="btn btn-danger w-100 fw-bold">Send Inquiry</button>
          </form>
          
          <!-- Optional: JavaScript to update total price based on duration -->
          <script>
            document.addEventListener('DOMContentLoaded', function() {
              const durationInput = document.querySelector('input[name="durationInMonths"]');
              const pricePerMonth =  listing.price ;
              const form = durationInput.closest('form');
              const totalPriceElement = document.createElement('p');
              totalPriceElement.classList.add('fw-bold', 'mt-2');
              form.insertBefore(totalPriceElement, durationInput.nextSibling);

              function updateTotalPrice() {
                const duration = parseInt(durationInput.value) || 0;
                const totalPrice = duration * pricePerMonth;
                totalPriceElement.textContent = `Total Price: ₹${totalPrice.toLocaleString("en-IN")}`;
              }

              durationInput.addEventListener('input', updateTotalPrice);
              updateTotalPrice(); // Initialize on page load
            });
          </script>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // JavaScript to update cover image when a thumbnail is clicked
  const coverImg = document.getElementById('coverImage');
  const thumbnails = document.querySelectorAll('.thumbnail');
  thumbnails.forEach(thumbnail => {
    thumbnail.addEventListener('click', function() {
      thumbnails.forEach(t => t.classList.remove('active'));
      coverImg.src = this.getAttribute('data-url');
      this.classList.add('active');
    });
  });
</script>  
