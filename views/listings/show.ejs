<% layout("/layouts/boilerplate") %>

<%
  // Compute overall average rating from all reviews
  let avgRating = 0;
  if (listing.reviews && listing.reviews.length > 0) {
    let sum = 0;
    listing.reviews.forEach(review => { sum += review.rating; });
    avgRating = sum / listing.reviews.length;
    avgRating = Math.round(avgRating * 10) / 10; // round to one decimal place
  }
%>

<!-- Add custom styles and animations -->
<style>
  /* Animation keyframes */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  @keyframes slideIn {
    from { transform: translateX(-30px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
  
  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }
  
  @keyframes shimmer {
    0% { background-position: -1000px 0; }
    100% { background-position: 1000px 0; }
  }
  
  /* Page elements styling */
  .listing-container {
    animation: fadeIn 0.8s ease-out;
  }
  
  .listing-title {
    font-weight: 700;
    letter-spacing: -0.5px;
    transition: all 0.3s ease;
    animation: slideIn 0.6s ease-out;
  }
  
  .listing-card {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
  }
  
  .listing-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
  }
  
  .cover-image-container {
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    max-height: 480px;
  }
  
  #coverImage {
    transition: all 0.5s ease;
    transform-origin: center;
    object-fit: cover;
  }
  
  .gallery-image {
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
    border: 3px solid transparent;
  }
  
  .gallery-image:hover {
    transform: scale(1.05);
    border-color: #ff5a5f;
    cursor: pointer;
  }
  
  .location-link {
    color: #ff5a5f;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  
  .location-link:hover {
    color: #ff2d35;
    text-decoration: underline;
  }
  
  .amenity-item {
    transition: all 0.3s ease;
    padding: 8px 15px;
    border-radius: 50px;
    background-color: #f8f9fa;
    margin-bottom: 10px;
    display: inline-flex;
    align-items: center;
  }
  
  .amenity-item:hover {
    background-color: #e9ecef;
    transform: translateX(5px);
  }
  
  .amenity-icon {
    color: #28a745;
    margin-right: 8px;
    transition: all 0.3s ease;
  }
  
  .amenity-item:hover .amenity-icon {
    transform: scale(1.2);
  }
  
  .review-card {
    border-radius: 12px;
    transition: all 0.3s ease;
    overflow: hidden;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    margin-bottom: 15px;
    animation: fadeIn 0.6s ease-out;
    animation-fill-mode: both;
  }
  
  .review-card:hover {
    transform: translateY(-3px) scale(1.01);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
  }
  
  .btn-action {
    transition: all 0.3s ease;
    border-radius: 50px;
    padding: 8px 20px;
    font-weight: 600;
  }
  
  .btn-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
  }
  
  .btn-delete {
    background-color: #fff;
    color: #dc3545;
    border: 1px solid #dc3545;
    transition: all 0.3s ease;
  }
  
  .btn-delete:hover {
    background-color: #dc3545;
    color: white;
  }
  
  .booking-card {
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    background: linear-gradient(145deg, #ffffff, #f5f5f5);
  }
  
  .booking-card:hover {
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
  }
  
  .form-control {
    border-radius: 8px;
    transition: all 0.3s ease;
    border: 2px solid #dee2e6;
  }
  
  .form-control:focus {
    border-color: #ff5a5f;
    box-shadow: 0 0 0 0.25rem rgba(255, 90, 95, 0.25);
  }
  
  .toggle-switch-wrapper {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }
  
  .switch {
    position: relative;
    display: inline-block;
    width: 60px;
    height: 34px;
    margin-right: 10px;
  }
  
  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  
  .slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #ccc;
    transition: .4s;
    border-radius: 34px;
  }
  
  .slider:before {
    position: absolute;
    content: "";
    height: 26px;
    width: 26px;
    left: 4px;
    bottom: 4px;
    background-color: white;
    transition: .4s;
    border-radius: 50%;
  }
  
  input:checked + .slider {
    background-color: #ff5a5f;
  }
  
  input:focus + .slider {
    box-shadow: 0 0 1px #ff5a5f;
  }
  
  input:checked + .slider:before {
    transform: translateX(26px);
  }
  
  /* Price tags */
  .price-tag {
    background: #ff5a5f;
    color: white;
    padding: 5px 15px;
    border-radius: 20px;
    font-weight: bold;
    display: inline-block;
    margin-bottom: 15px;
    box-shadow: 0 3px 10px rgba(255, 90, 95, 0.3);
  }
  
  /* Custom star animation */
  .star-rating {
    color: #ffc107;
    font-size: 20px;
  }
  
  .star-rating i {
    margin-right: 2px;
    transition: all 0.3s ease;
  }
  
  .star-rating:hover i {
    transform: rotate(72deg) scale(1.2);
  }
  
  /* Section headers */
  .section-header {
    position: relative;
    display: inline-block;
    margin-bottom: 25px;
    font-weight: 700;
  }
  
  .section-header:after {
    content: '';
    position: absolute;
    width: 50%;
    height: 3px;
    background-color: #ff5a5f;
    bottom: -5px;
    left: 0;
    transition: width 0.3s ease;
  }
  
  .section-header:hover:after {
    width: 100%;
  }
  
  /* Enhanced form animations */
  .booking-form-container {
    transition: all 0.5s ease;
    transform-origin: top;
    opacity: 1;
    max-height: 1000px;
  }
  
  .booking-form-container.hidden {
    opacity: 0;
    max-height: 0;
    overflow: hidden;
  }
  
  /* Loading shimmer effect */
  .shimmer {
    background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.5) 50%, rgba(255,255,255,0) 100%);
    background-size: 1000px 100%;
    animation: shimmer 2s infinite linear;
  }
</style>

<div class="container p-3 listing-container">
  <!-- Title and Location -->
  <div class="row mb-4">
    <div class="col-12">
      <h2 class="mt-2 text-start listing-title"><%= listing.title %></h2>
      <p class="card-text mb-2">
        <i class="bi bi-geo-alt-fill" style="color: #ff5a5f;"></i>
        <strong>Location:</strong>
        <a 
          href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(listing.location + ', ' + listing.country) %>"
          target="_blank"
          class="location-link"
        >
          <%= listing.location %>, <%= listing.country %>
        </a>
      </p>
    </div>
  </div>

  <!-- Images Section -->
  <div class="row">
    <div class="col-12">
      <div class="card listing-card" style="width: 100%;">
        <% 
          // The first image is used as the cover image
          const coverImage = (listing.images && listing.images.length > 0) 
            ? listing.images[0].url 
            : '/images/default.jpg';
          // The rest of the images (if any) become the gallery
          const galleryImages = (listing.images && listing.images.length > 1)
            ? listing.images.slice(1) 
            : [];
        %>

        <!-- Cover Image -->
        <div class="cover-image-container">
          <img 
            id="coverImage"
            src="<%= coverImage %>"
            alt="Cover Image"
            style="width: 100%; max-height: 480px;"
          >
        </div>

        <!-- Thumbnail Gallery (if more images exist) -->
        <% if (galleryImages.length > 0) { %>
          <div class="row mt-3">
            <% galleryImages.forEach((img, index) => { %>
              <div class="col-md-3 col-6 mb-3" style="animation: fadeIn  0.3 + (index * 0.1) s ease-out;">
                <div class="gallery-image">
                  <img 
                    src="<%= img.url %>"
                    alt="Gallery image <%= index + 1 %>"
                    style="object-fit: cover; width: 100%; height: 150px; cursor: pointer;"
                    onclick="changeMainImage('<%= img.url %>',  index + 1 )"
                  >
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>

        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <div class="d-flex align-items-center">
                <div class="star-rating">
                  <% for(let i = 1; i <= 5; i++) { %>
                    <i class="bi bi-star<%= i <= Math.round(avgRating) ? '-fill' : '' %>"></i>
                  <% } %>
                </div>
                <span class="ms-2"><%= avgRating %> / 5 (<%= listing.reviews ? listing.reviews.length : 0 %> reviews)</span>
              </div>
              <p class="card-text my-2">
                <strong>Hosted By:</strong> <i class="text-muted"><%= listing.owner.username %></i>
              </p>
            </div>
            <div class="price-tag">
              &#8377;<%= listing.price.toLocaleString("en-IN") %>
            </div>
          </div>
          <p class="card-text description mb-3"><%= listing.description %></p>
        </div>
      </div>

      <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
        <div class="text-center mt-4 mb-3">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark btn-action me-3">
            <i class="bi bi-pencil me-1"></i> Edit
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
            <button class="btn btn-danger btn-action">
              <i class="bi bi-trash me-1"></i> Delete
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <!-- "What This Place Offers" Section -->
  <% if (listing.amenities && listing.amenities.length > 0) { %>
    <div class="mt-5 mb-5">
      <h4 class="section-header">What this place offers</h4>
      <div class="row">
        <% listing.amenities.forEach((amenity, index) => { %>
          <div class="col-md-4 col-6" style="animation: slideIn  0.3 + (index * 0.1) s ease-out;">
            <div class="amenity-item">
              <i class="bi bi-check-circle-fill amenity-icon"></i>
              <%= amenity %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Reviews & Booking Section -->
  <div class="row">
    <!-- Reviews Column -->
    <div class="col-md-8 mb-5">
      <% if (currUser) { %>
        <h4 class="section-header">Leave a Review</h4>
        <div class="card mb-5 p-3 listing-card">
          <div class="card-body">
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
              <!-- Rating Field -->
              <div class="mb-4">
                <label for="rating" class="form-label fw-bold">Rating</label>
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>
              <!-- Comment Field -->
              <div class="mb-3">
                <label for="comment" class="form-label fw-bold">Comment</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" required></textarea>
                <div class="invalid-feedback">Please leave some comment!</div>
              </div>
              <button class="btn btn-outline-dark btn-action">
                <i class="bi bi-send me-1"></i> Submit Review
              </button>
            </form>
          </div>
        </div>
      <% } %>

      <!-- All Reviews -->
      <h4 class="section-header">All Reviews</h4>
      <div id="reviewsContainer" class="row">
        <% listing.reviews.forEach((review, index) => { %>
          <div class="col-md-6 mb-3" style="animation: fadeIn  0.3 + (index * 0.1) s ease-out;">
            <div class="review-card">
              <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start">
                  <h5 class="card-title mb-2"><i class="bi bi-person-circle me-2"></i><%= review.author.username %></h5>
                  <div class="d-flex align-items-center">
                    <% for(let i = 1; i <= 5; i++) { %>
                      <i class="bi bi-star<%= i <= review.rating ? '-fill' : '' %>" style="color: #ffc107;"></i>
                    <% } %>
                  </div>
                </div>
                <div class="border-top border-bottom py-2 my-2">
                  <p class="card-text"><%= review.comment %></p>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                  <small class="text-muted">Rating: <%= review.rating %>/5</small>
                  <% if (currUser && (currUser._id.equals(review.author._id) || currUser._id.equals(listing.owner._id))) { %>
                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="mb-0">
                      <button class="btn btn-sm btn-delete">
                        <i class="bi bi-trash"></i> Delete
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Booking Column -->
    <div class="col-md-4">
      <div class="card booking-card shadow p-3">
        <div class="card-body p-3">
          <% if (listing.rentalOption === 'both') { %>
            <!-- Toggle Switch for Both -->
            <div class="toggle-switch-wrapper mb-4">
              <label class="switch">
                <input type="checkbox" id="toggleBookingType" checked>
                <span class="slider"></span>
              </label>
              <span id="toggleLabel" class="fw-bold ms-2">Rent this place</span>
            </div>

            <!-- Book This Place Form -->
            <div id="bookForm" class="booking-form-container hidden">
              <h4 class="fw-bold mb-3">Book this place</h4>
              <div class="price-tag mb-3">
                <i class="bi bi-tag-fill me-1"></i> &#8377;<span id="nightlyPrice"></span> / night
              </div>
              <form action="/bookings" method="POST">
                <input type="hidden" name="listingId" value="<%= listing._id %>">
                <!-- Check-in Date -->
                <div class="mb-3">
                  <label for="checkin" class="form-label">
                    <i class="bi bi-calendar-check me-1"></i> Check-in Date
                  </label>
                  <input type="date" name="checkin" class="form-control" required>
                </div>
                <!-- Check-out Date -->
                <div class="mb-3">
                  <label for="checkout" class="form-label">
                    <i class="bi bi-calendar-x me-1"></i> Check-out Date
                  </label>
                  <input type="date" name="checkout" class="form-control" required>
                </div>
                <!-- Number of Guests -->
                <div class="mb-3">
                  <label for="guests" class="form-label">
                    <i class="bi bi-people-fill me-1"></i> Number of Guests
                  </label>
                  <input type="number" name="guests" class="form-control" min="1" max="4" required>
                </div>
                <!-- Full Name (Auto-filled) -->
                <div class="mb-3">
                  <label for="fullName" class="form-label">
                    <i class="bi bi-person-fill me-1"></i> Your Full Name
                  </label>
                  <input type="text" name="fullName" class="form-control" value="<%= currUser ? currUser.username : '' %>" readonly required>
                </div>
                <!-- Phone Number -->
                <div class="mb-3">
                  <label for="phone" class="form-label">
                    <i class="bi bi-telephone-fill me-1"></i> Phone Number
                  </label>
                  <input type="tel" name="phone" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-danger w-100 fw-bold btn-action">
                  <i class="bi bi-calendar-check me-1"></i> Book Now
                </button>
              </form>
            </div>

            <!-- Rent This Place Form -->
            <div id="rentForm" class="booking-form-container">
              <h4 class="fw-bold mb-3">Rent this place</h4>
              <div class="price-tag mb-3">
                <i class="bi bi-tag-fill me-1"></i> &#8377;<%= listing.price.toLocaleString("en-IN") %> / month
              </div>
              <form action="/bookings" method="POST">
                <input type="hidden" name="listingId" value="<%= listing._id %>">
                <!-- Expected Move-in Date -->
                <div class="mb-3">
                  <label for="startDate" class="form-label">
                    <i class="bi bi-calendar-plus me-1"></i> Expected Move-in Date
                  </label>
                  <input type="date" name="startDate" class="form-control" required>
                </div>
                <!-- Duration in Months -->
                <div class="mb-3">
                  <label for="durationInMonths" class="form-label">
                    <i class="bi bi-clock-history me-1"></i> Duration (in months)
                  </label>
                  <input type="number" name="durationInMonths" class="form-control" min="1" required>
                </div>
                <!-- Full Name (Auto-filled) -->
                <div class="mb-3">
                  <label for="fullName" class="form-label">
                    <i class="bi bi-person-fill me-1"></i> Your Full Name
                  </label>
                  <input type="text" name="fullName" class="form-control" value="<%= currUser ? currUser.username : '' %>" readonly required>
                </div>
                <!-- Phone Number -->
                <div class="mb-3">
                  <label for="phone" class="form-label">
                    <i class="bi bi-telephone-fill me-1"></i> Phone Number
                  </label>
                  <input type="tel" name="phone" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-danger w-100 fw-bold btn-action">
                  <i class="bi bi-send me-1"></i> Send Inquiry
                </button>
              </form>
            </div>
          <% } else if (listing.rentalOption === 'booking') { %>
            <!-- Only Booking Form -->
            <h4 class="fw-bold mb-3">Book this place</h4>
            <div class="price-tag mb-3">
              <i class="bi bi-tag-fill me-1"></i> &#8377;<span id="nightlyPrice"></span> / night
            </div>
            <form action="/bookings" method="POST">
              <input type="hidden" name="listingId" value="<%= listing._id %>">
              <!-- Check-in Date -->
              <div class="mb-3">
                <label for="checkin" class="form-label">
                  <i class="bi bi-calendar-check me-1"></i> Check-in Date
                </label>
                <input type="date" name="checkin" class="form-control" required>
              </div>
              <!-- Check-out Date -->
              <div class="mb-3">
                <label for="checkout" class="form-label">
                  <i class="bi bi-calendar-x me-1"></i> Check-out Date
                </label>
                <input type="date" name="checkout" class="form-control" required>
              </div>
              <!-- Number of Guests -->
              <div class="mb-3">
                <label for="guests" class="form-label">
                  <i class="bi bi-people-fill me-1"></i> Number of Guests
                </label>
                <input type="number" name="guests" class="form-control" min="1" max="4" required>
              </div>
              <!-- Full Name (Auto-filled) -->
              <div class="mb-3">
                <label for="fullName" class="form-label">
                  <i class="bi bi-person-fill me-1"></i> Your Full Name
                </label>
                <input type="text" name="fullName" class="form-control" value="<%= currUser ? currUser.username : '' %>" readonly required>
              </div>
              <!-- Phone Number -->
              <div class="mb-3">
                <label for="phone" class="form-label">
                  <i class="bi bi-telephone-fill me-1"></i> Phone Number
                </label>
                <input type="tel" name="phone" class="form-control" required>
              </div>
              <button type="submit" class="btn btn-danger w-100 fw-bold btn-action">
                <i class="bi bi-calendar-check me-1"></i> Book Now
              </button>
            </form>
          <% } else if (listing.rentalOption === 'rent') { %>
            <!-- Only Rent Form -->
            <h4 class="fw-bold mb-3">Rent this place</h4>
            <div class="price-tag mb-3">
              <i class="bi bi-tag-fill me-1"></i> &#8377;<%= listing.price.toLocaleString("en-IN") %> / month
            </div>
            <form action="/bookings" method="POST">
              <input type="hidden" name="listingId" value="<%= listing._id %>">
              <!-- Expected Move-in Date -->
              <div class="mb-3">
                <label for="startDate" class="form-label">
                  <i class="bi bi-calendar-plus me-1"></i> Expected Move-in Date
                </label>
                <input type="date" name="startDate" class="form-control" required>
              </div>
              <!-- Duration in Months -->
              <div class="mb-3">
                <label for="durationInMonths" class="form-label">
                  <i class="bi bi-clock-history me-1"></i> Duration (in months)
                </label>
                <input type="number" name="durationInMonths" class="form-control" min="1" required>
              </div>
              <!-- Full Name (Auto-filled) -->
              <div class="mb-3">
                <label for="fullName" class="form-label">
                  <i class="bi bi-person-fill me-1"></i> Your Full Name
                </label>
                <input type="text" name="fullName" class="form-control" value="<%= currUser ? currUser.username : '' %>" readonly required>
              </div>
              <!-- Phone Number -->
              <div class="mb-3">
                <label for="phone" class="form-label">
                  <i class="bi bi-telephone-fill me-1"></i> Phone Number
                </label>
                <input type="tel" name="phone" class="form-control" required>
              </div>
              <button type="submit" class="btn btn-danger w-100 fw-bold btn-action">
                <i class="bi bi-send me-1"></i> Send Inquiry
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Main image change with animation
function changeMainImage(imgSrc, index) {
  const coverImage = document.getElementById('coverImage');
  
  // Add fade out animation
  coverImage.style.opacity = '0';
  coverImage.style.transform = 'scale(0.95)';
  
  // Change the image after the fade out
  setTimeout(() => {
    coverImage.src = imgSrc;
    
    // Add fade in animation
    setTimeout(() => {
      coverImage.style.opacity = '1';
      coverImage.style.transform = 'scale(1)';
    }, 50);
  }, 300);
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
   if(listing.rentalOption === 'both') { 
    const toggleSwitch = document.getElementById('toggleBookingType');
    const bookForm = document.getElementById('bookForm');
    const rentForm = document.getElementById('rentForm');
    const toggleLabel = document.getElementById('toggleLabel');
    const monthlyPrice = listing.price ; // Monthly price from your server-side code
    const nightlyPriceElement = document.getElementById('nightlyPrice');

    // Function to calculate and display the nightly price
    function displayNightlyPrice() {
      const daysInMonth = 30; // Assuming 30 days in a month
      const dailyPrice = monthlyPrice / daysInMonth;
      const inflatedDailyPrice = dailyPrice * 3;
      nightlyPriceElement.textContent = inflatedDailyPrice.toLocaleString("en-IN");
    }

    // Initial display of nightly price
    displayNightlyPrice();

    // Set initial form visibility based on the toggle switch being checked by default
    function updateForms() {
      if (toggleSwitch.checked) {
        bookForm.classList.add('hidden');
        rentForm.classList.remove('hidden');
        toggleLabel.textContent = 'Book this place';
        // Add animation
        toggleLabel.style.animation = 'none';
        setTimeout(() => {
          toggleLabel.style.animation = 'pulse 0.5s ease';
        }, 10);
      } else {
        bookForm.classList.remove('hidden');
        rentForm.classList.add('hidden');
        toggleLabel.textContent = 'Rent this place';
        // Add animation
        toggleLabel.style.animation = 'none';
        setTimeout(() => {
          toggleLabel.style.animation = 'pulse 0.5s ease';
        }, 10);
      }
    }

    // Initial update
    updateForms();

    // Toggle between forms on switch change
    toggleSwitch.addEventListener('change', updateForms);
  } else if(listing.rentalOption === 'booking') { 
    // For booking-only listing, calculate nightly price
    const monthlyPrice = listing.price ; // Monthly price
    const nightlyPriceElement = document.getElementById('nightlyPrice');
    const daysInMonth = 30;
    const dailyPrice = monthlyPrice / daysInMonth;
    const inflatedDailyPrice = dailyPrice * 3;
    nightlyPriceElement.textContent = inflatedDailyPrice.toLocaleString("en-IN");
  } 

  // Add animation to reviews (staggered appearance)
  const reviewCards = document.querySelectorAll('.review-card');
  reviewCards.forEach((card, index) => {
    setTimeout(() => {
      card.style.opacity = '1';
      card.style.transform = 'translateY(0)';
    }, 100 * index);
  });

  // Add hover animation to amenities
  const amenityItems = document.querySelectorAll('.amenity-item');
  amenityItems.forEach(item => {
    item.addEventListener('mouseenter', function() {
      const icon = this.querySelector('.amenity-icon');
      icon.style.animation = 'pulse 0.5s infinite';
    });
    
    item.addEventListener('mouseleave', function() {
      const icon = this.querySelector('.amenity-icon');
      icon.style.animation = 'none';
    });
  });

  // Add animation to star ratings
  const starRating = document.querySelector('.star-rating');
  if (starRating) {
    const stars = starRating.querySelectorAll('i');
    stars.forEach((star, index) => {
      star.style.transitionDelay = $;{index * 0.1}s;
    });
  }
});
</script>