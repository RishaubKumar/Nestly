<% layout("/layouts/boilerplate") %>
<div class="container mt-4">
  <h2 class="text-center fw-bold"><%= listing.title %></h2>
  <p class="text-center text-muted">
    <i class="fas fa-map-marker-alt"></i> <%= listing.location %>, <%= listing.country %>
  </p>
  
  <div class="row mt-4">
    <div class="col-md-6 text-start">
      <img src="<%= listing.image.url %>" class="img-fluid rounded shadow-lg" alt="listing image" style="width: 100%; height: auto; display: block; margin: 0 auto; max-height: 400px; object-fit: cover;">
    </div>
    <div class="col-md-6 d-flex align-items-center">
      <div class="w-100">
        <h4 class="fw-bold">Description</h4>
        <p><strong>Owned by:</strong> <%= listing.owner.username %></p>
        <p><strong>Location:</strong> <%= listing.location %>, <%= listing.country %></p>
        <p><%= listing.description %></p>
      </div>
    </div>
  </div>
  
  <div class="row mt-4">
    <div class="col-md-8">
      <div class="card p-4 shadow-sm mb-3">
        <h4 class="fw-bold">Reviews</h4>
        <% listing.reviews.forEach(review => { %>
          <div class="card p-3 mb-2 shadow-sm">
            <h5 class="fw-bold"><%= review.author.username %></h5>
            <p>⭐ <%= review.rating %> / 5</p>
            <p><%= review.comment %></p>
          </div>
        <% }) %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card p-3 shadow-sm" style="width: 100%;">
        <h4 class="fw-bold">Book this Place</h4>
        <p><strong>Price:</strong> &#8377;<%= listing.price.toLocaleString("en-IN") %> / night</p>
        <form action="/bookings" method="POST">
          <input type="hidden" name="listingId" value="<%= listing._id %>">
          <div class="mb-2">
            <label for="checkin" class="form-label">Check-in Date</label>
            <input type="date" name="checkin" class="form-control" required>
          </div>
          <div class="mb-2">
            <label for="checkout" class="form-label">Check-out Date</label>
            <input type="date" name="checkout" class="form-control" required>
          </div>
          <div class="mb-2">
            <label for="guests" class="form-label">Number of Guests</label>
            <input type="number" name="guests" class="form-control" min="1" max="4" required>
          </div>
          <div class="mb-2">
            <label for="fullName" class="form-label">Your Full Name</label>
            <input type="text" name="fullName" class="form-control" required>
          </div>
          <div class="mb-2">
            <label for="phone" class="form-label">Phone Number</label>
            <input type="tel" name="phone" class="form-control" required>
          </div>
          <button type="submit" class="btn btn-danger w-100 fw-bold">Book Now</button>
        </form>
      </div>
    </div>
  </div>
</div>
