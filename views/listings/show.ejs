<% layout("/layouts/boilerplate") %>

<!-- Outer Container with Padding -->
<div class="container p-4">
  <!-- Listing Details Section -->
  <div class="row mb-5">
    <div class="col-8 offset-2">
      <h3 class="mt-2 text-center"><%= listing.title %></h3>
      <div class="card listing-card mt-4 mx-auto" style="max-width: 600px;">
        <% if(listing.image && listing.image.url) { %>
          <img
            src="<%= listing.image.url %>"
            class="card-img-top show-img"
            alt="listing image"
            style="object-fit: cover; max-height: 400px;"
          >
        <% } else if(listing.image) { %>
          <img
            src="<%= listing.image %>"
            class="card-img-top show-img"
            alt="listing image"
            style="object-fit: cover; max-height: 400px;"
          >
        <% } %>

        <div class="card-body p-3">
          <p class="card-text mb-1">
            <strong>Owned By:</strong>
            <i><%= listing.owner.username %></i>
          </p>
          <p class="card-text mb-1"><%= listing.description %></p>
          <p class="card-text mb-1">
            <strong>Price:</strong>
            &#8377;<%= listing.price.toLocaleString("en-IN") %>
          </p>
          <p class="card-text mb-1"><%= listing.location %></p>
          <p class="card-text mb-0"><%= listing.country %></p>
        </div>
      </div>

      <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
        <div class="text-center mt-3">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark me-2">Edit</a>
          <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=DELETE"
            class="d-inline"
          >
            <button class="btn btn-danger">Delete</button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <hr>

  <!-- Reviews & Booking Section -->
  <div class="row">
    <!-- Reviews Column -->
    <div class="col-md-8 mb-5">
      <% if (currUser) { %>
        <h4 class="mb-3">Leave a Review</h4>
        <form
          action="/listings/<%= listing._id %>/reviews"
          method="POST"
          novalidate
          class="needs-validation mb-5"
        >
          <!-- Rating Field -->
          <div class="mb-3">
            <label for="rating" class="form-label">Rating</label>
            <fieldset class="starability-slot">
              <input
                type="radio"
                id="no-rate"
                class="input-no-rate"
                name="review[rating]"
                value="1"
                checked
                aria-label="No rating."
              />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>

              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>

              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>

              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>

              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>

          <!-- Comment Field -->
          <div class="mb-3">
            <label for="comment" class="form-label">Comment</label>
            <textarea
              name="review[comment]"
              id="comment"
              cols="30"
              rows="4"
              class="form-control"
              required
            ></textarea>
            <div class="invalid-feedback">Please leave some comment!</div>
          </div>

          <button class="btn btn-outline-dark">Submit</button>
        </form>
      <% } %>

      <!-- All Reviews -->
      <h4 class="mb-3">All Reviews</h4>
      <div class="row">
        <% listing.reviews.forEach(review => { %>
          <div class="card col-5 ms-3 mb-3 p-0">
            <div class="card-body p-3">
              <h5 class="card-title"><%= review.author.username %></h5>
              <p class="starability-result mb-1" data-rating="<%= review.rating %>"></p>
              <p class="card-text mb-1"><%= review.comment %></p>
              <p class="card-text"><%= review.rating %> Stars</p>

              <form
                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                method="POST"
                class="mb-0"
              >
                <button class="btn btn-sm btn-danger">Delete</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Booking Column -->
    <div class="col-md-4">
      <div class="card shadow-sm p-3">
        <div class="card-body p-3">
          <h4 class="fw-bold">Book this Place</h4>
          <p>
            <strong>Price:</strong>
            &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
          </p>

          <form action="/user/dashboard" method="POST">
            <input type="hidden" name="listingId" value="<%= listing._id %>">

            <!-- Check-in Date -->
            <div class="mb-3">
              <label for="checkin" class="form-label">Check-in Date</label>
              <input
                type="date"
                name="checkin"
                class="form-control"
                required
              >
            </div>

            <!-- Check-out Date -->
            <div class="mb-3">
              <label for="checkout" class="form-label">Check-out Date</label>
              <input
                type="date"
                name="checkout"
                class="form-control"
                required
              >
            </div>

            <!-- Number of Guests -->
            <div class="mb-3">
              <label for="guests" class="form-label">Number of Guests</label>
              <input
                type="number"
                name="guests"
                class="form-control"
                min="1"
                max="4"
                required
              >
            </div>

            <!-- Full Name (Auto-filled) -->
            <div class="mb-3">
              <label for="fullName" class="form-label">Your Full Name</label>
              <input
                type="text"
                name="fullName"
                class="form-control"
                value="<%= currUser ? currUser.username : '' %>"
                readonly
                required
              >
            </div>

            <!-- Phone Number -->
            <div class="mb-3">
              <label for="phone" class="form-label">Phone Number</label>
              <input
                type="tel"
                name="phone"
                class="form-control"
                required
              >
            </div>

            <button
              type="submit"
              class="btn btn-danger w-100 fw-bold"
            >
              Book Now
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>