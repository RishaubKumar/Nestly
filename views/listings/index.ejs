<!-- Renders the main directory of property listings, with filters for location and rental option -->

<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
  <!-- Search & Filter Form -->
  <form method="GET" action="/listings" class="bg-light p-3 rounded mb-4 border-start border-danger border-4 border-end-0 border-top-0 border-bottom-0">
    <div class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-danger"></i></span>
          <input type="text" name="q" class="form-control border-start-0" placeholder="Search by location..." value="<%= typeof q !== 'undefined' ? q : '' %>">
        </div>
      </div>
      <div class="col-md-5">
        <select name="rentalOption" class="form-select">
          <option value="">All Listings (Booking & Rent)</option>
          <option value="rent" <%= rentalOption === 'rent' ? 'selected' : '' %>>Rentals Only</option>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-danger w-100 fw-bold">Search</button>
      </div>
    </div>
  </form>

  <!-- Listings Grid -->
  <% if (allListings && allListings.length > 0) { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% allListings.forEach(function(listing) { %>
        <div class="col">
          <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
            <div class="card h-100 shadow-sm border-0 border-top border-danger border-3">
              <% if (listing.images && listing.images.length > 0) { %>
                <img src="<%= listing.images[0].url %>" class="card-img-top" alt="<%= listing.title %>" style="height: 200px; object-fit: cover;">
              <% } else { %>
                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                  <i class="bi bi-house-door text-danger" style="font-size: 3rem;"></i>
                </div>
              <% } %>
              <div class="card-body">
                <h5 class="card-title fw-bold text-truncate"><%= listing.title %></h5>
                <p class="card-text text-danger fw-bold mb-1">
                  &#8377; <%= listing.price.toLocaleString("en-IN") %>
                  <% if (listing.rentalOption === 'booking') { %>
                    / day
                  <% } else { %>
                    / month
                  <% } %>
                </p>
                <p class="card-text text-muted mb-2"><i class="bi bi-geo-alt me-1"></i><%= listing.location %></p>
                <span class="badge bg-danger text-uppercase"><%= listing.rentalOption %></span>
              </div>
            </div>
          </a>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="text-center py-5">
      <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
      <h4 class="mt-3">No listings found</h4>
      <p class="text-muted">Try adjusting your search criteria or browse all options.</p>
    </div>
  <% } %>
</div>
