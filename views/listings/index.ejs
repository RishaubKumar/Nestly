<% layout("/layouts/boilerplate") %>
<body>
  <div class="container mt-4">
    <!-- Search Bar -->
    <form method="GET" action="/listings" class="mb-4">
      <div class="input-group">
        <input type="text" name="q" class="form-control" placeholder="Search by location..." value="<%= typeof q !== 'undefined' ? q : '' %>">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
      </div>
    </form>
    
    <!-- Listings Grid -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
      <% allListings.forEach(function(listing) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="card col listing-card">
            <% if (listing.images && listing.images.length > 0) { %>
              <img src="<%= listing.images[0].url %>" class="card-img-top" alt="Listing Image" style="height: 20rem;">
            <% } %>
            <div class="card-body">
              <p class="card-text">
                <b><%= listing.title %></b>
                <br>&#8377; <%= listing.price.toLocaleString("en-IN") %>/month
                <br><small><%= listing.location %></small>
              </p>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</body>


