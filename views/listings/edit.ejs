<% layout("/layouts/boilerplate") %>
<div class="container mt-4">
  <h1>Edit Listing</h1>
  <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
    <!-- Title -->
    <div class="mb-3">
      <label for="title" class="form-label">Title</label>
      <input type="text" name="listing[title]" id="title" class="form-control" value="<%= listing.title %>" required>
    </div>
    <!-- Description -->
    <div class="mb-3">
      <label for="description" class="form-label">Description</label>
      <textarea name="listing[description]" id="description" class="form-control" rows="4" required><%= listing.description %></textarea>
    </div>
    <!-- Price -->
    <div class="mb-3">
      <label for="price" class="form-label">Price</label>
      <input type="number" name="listing[price]" id="price" class="form-control" value="<%= listing.price %>" required>
    </div>
    <!-- Location -->
    <div class="mb-3">
      <label for="location" class="form-label">Location</label>
      <input type="text" name="listing[location]" id="location" class="form-control" value="<%= listing.location %>" required>
    </div>
    <!-- Country -->
    <div class="mb-3">
      <label for="country" class="form-label">Country</label>
      <input type="text" name="listing[country]" id="country" class="form-control" value="<%= listing.country %>" required>
    </div>
    
    <!-- Amazon-like Gallery for Existing Images with Delete Option -->
    <div class="mb-3">
      <label class="form-label">Existing Images</label>
      <% if(listing.images && listing.images.length > 0) { %>
        <div class="gallery-container" style="display: flex; gap: 20px;">
          <div class="main-image" style="flex: 1; max-width: 60%; border: 1px solid #ddd; padding: 5px;">
            <img id="selectedImage" src="<%= listing.images[0].url %>" alt="Main Image" style="width: 100%; height: auto; object-fit: cover;">
          </div>
          <div class="thumbnails" style="display: flex; flex-direction: column; gap: 10px; max-width: 35%;">
            <% listing.images.forEach(function(image, index) { %>
              <div class="thumbnail-container" style="border: 1px solid #ddd; padding: 2px;">
                <div class="thumbnail <%= index === 0 ? 'active' : '' %>" data-url="<%= image.url %>" style="cursor: pointer;">
                  <img src="<%= image.url %>" alt="Thumbnail <%= index + 1 %>" style="width: 100%; height: auto; object-fit: cover;">
                </div>
                <div style="text-align: center; margin-top: 5px;">
                  <label>
                    <input type="checkbox" name="deleteImages" value="<%= image.filename %>"> Delete
                  </label>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } else { %>
        <p>No images available.</p>
      <% } %>
    </div>
    
    <!-- Upload New Images -->
    <div class="mb-3">
      <label for="newImages" class="form-label">Add New Images</label>
      <input type="file" name="images" id="newImages" class="form-control" multiple>
    </div>
    <button type="submit" class="btn btn-primary">Update Listing</button>
  </form>
</div>

<script>
  // JavaScript to update main image on thumbnail click
  const thumbnails = document.querySelectorAll('.thumbnail');
  const selectedImage = document.getElementById('selectedImage');
  thumbnails.forEach(thumbnail => {
    thumbnail.addEventListener('click', function() {
      thumbnails.forEach(t => t.classList.remove('active'));
      selectedImage.src = this.getAttribute('data-url');
      this.classList.add('active');
    });
  });
</script>
