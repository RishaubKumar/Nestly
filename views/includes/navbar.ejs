<!-- Enhanced Navbar with red and white theme -->
<!-- Add this in your head section -->
<style>
  /* Custom Navbar Styling - Red & White Theme */
  :root {
    --primary-red: #e41e3f;
    --dark-red: #c41230;
    --light-red: #ff3a5e;
    --very-light-red: #fff0f3;
  }
  
  .navbar {
    background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
    box-shadow: 0 3px 12px rgba(228, 30, 63, 0.15);
    padding: 0.7rem 1rem;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    border-bottom: 2px solid var(--primary-red);
  }
  
  .navbar-brand {
    font-weight: 700;
    font-size: 1.6rem;
    position: relative;
    overflow: hidden;
    color: var(--primary-red) !important;
  }
  
  .navbar-brand i {
    color: var(--primary-red);
    transition: all 0.5s cubic-bezier(0.68, -0.55, 0.27, 1.55);
    display: inline-block;
    text-shadow: 0 0 0 transparent;
  }
  
  .navbar-brand:hover i {
    transform: rotate(360deg) scale(1.2);
    color: var(--dark-red);
    text-shadow: 0 0 10px rgba(228, 30, 63, 0.4);
    animation: pulse 1.5s infinite;
  }
  
  .nav-link {
    position: relative;
    margin: 0 5px;
    padding: 0.6rem 1rem !important;
    font-weight: 500;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    border-radius: 5px;
    color: #444 !important;
  }
  
  .nav-link:before {
    content: "";
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 4px;
    left: 50%;
    background-color: var(--primary-red);
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    transform: translateX(-50%);
    opacity: 0;
  }
  
  .nav-link:after {
    content: "";
    position: absolute;
    width: 100%;
    transform: scaleX(0);
    height: 100%;
    top: 0;
    left: 0;
    background-color: rgba(228, 30, 63, 0.05);
    transform-origin: bottom right;
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    border-radius: 5px;
    z-index: -1;
  }
  
  .nav-link:hover:after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }
  
  .nav-link:hover:before, 
  .nav-link.active:before {
    width: 80%;
    opacity: 1;
  }
  
  .nav-link:hover {
    color: var(--primary-red) !important;
    transform: translateY(-2px);
  }
  
  .nav-link.active {
    color: var(--primary-red) !important;
    font-weight: 600;
    background-color: var(--very-light-red);
  }
  
  .dropdown-menu {
    border: none;
    box-shadow: 0 5px 20px rgba(228, 30, 63, 0.15);
    border-radius: 8px;
    animation: fadeIn 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    transform-origin: top center;
    border-top: 3px solid var(--primary-red);
    background: #ffffff;
    padding: 0.5rem;
  }
  
  .dropdown-item {
    padding: 0.7rem 1.2rem;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    border-radius: 5px;
    margin: 2px 0;
  }
  
  .dropdown-item:hover {
    background-color: var(--very-light-red);
    transform: translateX(5px);
    color: var(--primary-red);
  }
  
  .dropdown-divider {
    margin: 0.3rem 0;
    opacity: 0.2;
    border-color: var(--primary-red);
  }
  
  .navbar-toggler {
    border: none;
    padding: 0.4rem;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    color: var(--primary-red);
  }
  
  .navbar-toggler:focus {
    box-shadow: none;
    outline: none;
  }
  
  .navbar-toggler-icon {
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28228, 30, 63, 1%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
  }
  
  .navbar-toggler:hover .navbar-toggler-icon {
    transform: scale(1.1);
  }
  
  /* Animated Navigation for Mobile */
  .navbar-collapse {
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  
  .navbar-collapse.collapsing {
    height: auto;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  
  .navbar-collapse.show {
    animation: slideDown 0.5s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scaleY(0.8) translateY(-10px);
    }
    to {
      opacity: 1;
      transform: scaleY(1) translateY(0);
    }
  }
  
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Pulse animation for notification */
  @keyframes pulse {
    0% {
      text-shadow: 0 0 5px rgba(228, 30, 63, 0.4);
    }
    50% {
      text-shadow: 0 0 15px rgba(228, 30, 63, 0.6);
    }
    100% {
      text-shadow: 0 0 5px rgba(228, 30, 63, 0.4);
    }
  }
  
  /* User dropdown animation */
  #userDropdown {
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  
  #userDropdown:hover {
    background-color: var(--very-light-red);
    border-radius: 5px;
  }
  
  #userDropdown i {
    margin-right: 5px;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    color: var(--primary-red);
  }
  
  #userDropdown:hover i {
    transform: scale(1.2) rotate(12deg);
    color: var(--dark-red);
  }
  
  /* Special buttons for sign up/login */
  .nav-link.btn-outline-red {
    border: 1px solid var(--primary-red);
    color: var(--primary-red) !important;
    margin-left: 5px;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  
  .nav-link.btn-outline-red:hover {
    background-color: var(--primary-red);
    color: white !important;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(228, 30, 63, 0.2);
  }
  
  .nav-link.btn-red {
    background-color: var(--primary-red);
    color: white !important;
    margin-left: 5px;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  
  .nav-link.btn-red:hover {
    background-color: var(--dark-red);
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(228, 30, 63, 0.2);
  }
  
  .nav-link.btn-red:before,
  .nav-link.btn-outline-red:before {
    height: 0;
  }
  
  /* Shine effect for brand */
  .navbar-brand:after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.3) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: rotate(30deg);
    transition: all 1s;
    opacity: 0;
  }
  
  .navbar-brand:hover:after {
    opacity: 1;
    transform: rotate(30deg) translate(100%, -100%);
  }
  
  /* Animation for notifications */
  .notification-badge {
    position: absolute;
    top: 0;
    right: 2px;
    background: var(--primary-red);
    color: white;
    font-size: 0.7rem;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transform: scale(1);
    animation: notificationPulse 2s infinite;
  }
  
  @keyframes notificationPulse {
    0% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(228, 30, 63, 0.7);
    }
    70% {
      transform: scale(1.1);
      box-shadow: 0 0 0 6px rgba(228, 30, 63, 0);
    }
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(228, 30, 63, 0);
    }
  }
  
  /* Sticky navbar animation */
  .navbar.scrolled {
    padding: 0.5rem 1rem;
    background-color: rgba(255, 255, 255, 0.98);
  }
  
  /* Mobile adjustments */
  @media (max-width: 767.98px) {
    .navbar-collapse {
      background-color: white;
      border-radius: 0 0 10px 10px;
      padding: 1rem;
      margin-top: 0.5rem;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
      border-top: 2px solid var(--primary-red);
    }
    
    .navbar-nav {
      padding: 0.5rem 0;
    }
    
    .nav-link {
      padding: 0.8rem 1rem !important;
      margin: 3px 0;
    }
    
    .navbar-nav .nav-link.btn-red,
    .navbar-nav .nav-link.btn-outline-red {
      margin: 5px 0;
      text-align: center;
    }
  }
</style>

<nav class="navbar navbar-expand-md sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/home"><i class="fa-solid fa-location-arrow"></i> Nestly</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link active" href="/home">
          <i class="fa-solid fa-house me-1"></i> Home
        </a>
        <a class="nav-link" href="/listings">
          <i class="fa-solid fa-map me-1"></i> All Listings
        </a>
        <a class="nav-link" href="/listings/new">
          <i class="fa-solid fa-plus me-1"></i> Add New Listing
        </a>
      </div>
      <div class="navbar-nav ms-auto">
        <% if (!currUser) { %>
          <a class="nav-link btn-outline-red" href="/signup">
            <i class="fa-solid fa-user-plus me-1"></i> Sign Up
          </a>
          <a class="nav-link btn-red" href="/login">
            <i class="fa-solid fa-right-to-bracket me-1"></i> Login
          </a>
        <% } else { %>
          <div class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fa-solid fa-user-circle"></i> <%= currUser.username %>
              <!-- Uncomment to add notification badge -->
              <!-- <span class="notification-badge">2</span> -->
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
              <li>
                <a class="dropdown-item" href="/user/dashboard">
                  <i class="fa-solid fa-gauge-high me-2"></i> My Dashboard
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="/owner/dashboard">
                  <i class="fa-solid fa-calendar-check me-2"></i> Booking Requests
                </a>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <a class="dropdown-item" href="/logout">
                  <i class="fa-solid fa-sign-out-alt me-2"></i> Logout
                </a>
              </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<!-- Add this before the closing body tag -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Animate navbar on scroll
    const navbar = document.querySelector('.navbar');
    let lastScrollTop = 0;
    
    window.addEventListener('scroll', function() {
      let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      
      if (scrollTop > lastScrollTop && scrollTop > 60) {
        // Scroll down - hide navbar
        navbar.style.transform = 'translateY(-100%)';
      } else {
        // Scroll up - show navbar
        navbar.style.transform = 'translateY(0)';
        
        if (scrollTop > 20) {
          navbar.classList.add('scrolled');
          navbar.style.boxShadow = '0 4px 20px rgba(228, 30, 63, 0.15)';
        } else {
          navbar.classList.remove('scrolled');
          navbar.style.boxShadow = '0 3px 12px rgba(228, 30, 63, 0.15)';
        }
      }
      
      lastScrollTop = scrollTop;
    });
    
    // Add active class to current link
    const currentPath = window.location.pathname;
    document.querySelectorAll('.navbar-nav .nav-link').forEach(link => {
      const href = link.getAttribute('href');
      if (href === currentPath || (href !== '/login' && href !== '/signup' && currentPath.startsWith(href) && href !== '/home')) {
        link.classList.add('active');
      } else {
        link.classList.remove('active');
      }
    });
    
    // Enhanced dropdown animation
    const dropdownToggle = document.getElementById('userDropdown');
    const dropdownMenu = document.querySelector('.dropdown-menu');
    
    if (dropdownToggle) {
      // Add hover effect for desktop
      if (window.innerWidth >= 768) {
        const dropdownParent = dropdownToggle.parentElement;
        
        dropdownParent.addEventListener('mouseenter', function() {
          dropdownMenu.classList.add('show');
          dropdownToggle.setAttribute('aria-expanded', 'true');
        });
        
        dropdownParent.addEventListener('mouseleave', function() {
          dropdownMenu.classList.remove('show');
          dropdownToggle.setAttribute('aria-expanded', 'false');
        });
      }
      
      // Add ripple effect to dropdown items
      document.querySelectorAll('.dropdown-item').forEach(item => {
        item.addEventListener('click', function(e) {
          const rect = item.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          
          const ripple = document.createElement('span');
          ripple.style.cssText = `
            position: absolute;
            background: rgba(228, 30, 63, 0.2);
            border-radius: 50%;
            width: 100px;
            height: 100px;
            left: ${x}px;
            top: ${y}px;
            transform: translate(-50%, -50%);
            pointer-events: none;
            opacity: 0;
            transition: all 0.5s ease;
          `;
          
          item.appendChild(ripple);
          
          setTimeout(() => {
            ripple.style.transform = 'translate(-50%, -50%) scale(4)';
            ripple.style.opacity = '0.2';
            
            setTimeout(() => {
              ripple.remove();
            }, 500);
          }, 10);
        });
      });
    }
    
    // Logo animation on load
    const logo = document.querySelector('.navbar-brand i');
    if (logo) {
      logo.style.transform = 'scale(0)';
      setTimeout(() => {
        logo.style.transform = 'scale(1.2)';
        setTimeout(() => {
          logo.style.transform = 'scale(1)';
        }, 200);
      }, 300);
    }
  });
</script>