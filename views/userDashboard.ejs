<% layout("/layouts/boilerplate") %>
<div class="container mt-4">
  <h1>Your Bookings</h1>
  <ul class="list-group">
    <% bookings.forEach(booking => { 
         // Calculate the time difference between now and check-in:
         const now = new Date();
         const checkIn = new Date(booking.checkIn);
         const diffInMs = checkIn - now;
         const hoursDiff = diffInMs / (1000 * 60 * 60);
    %>
      <li class="list-group-item">
        <strong>Property:</strong> 
        <% if (booking.property) { %>
          <%= booking.property.title %>
        <% } else { %>
          <span class="text-muted">[Property not available]</span>
        <% } %>
        <br>
        <strong>Check-in:</strong> <%= new Date(booking.checkIn).toLocaleDateString() %>
        <br>
        <strong>Check-out:</strong> <%= new Date(booking.checkOut).toLocaleDateString() %>
        <br>
        <strong>Status:</strong> <%= booking.status %>
        <br>
        <% if (booking.status !== "cancelled" && hoursDiff >= 24) { %>
          <form action="/bookings/<%= booking._id %>/cancel" method="POST" class="mt-2">
            <button type="submit" class="btn btn-warning btn-sm">Cancel Booking</button>
          </form>
        <% } else if (booking.status !== "cancelled" && hoursDiff < 24) { %>
          <small class="text-danger">Cancellation not allowed within 24 hours of check-in.</small>
        <% } %>
      </li>
    <% }) %>
  </ul>
</div>
