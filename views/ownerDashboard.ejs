<% layout("/layouts/boilerplate") %>
<div class="container mt-4">
  <h1>Owner Dashboard</h1>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Property</th>
        <th>Guest Name</th>
        <th>Move-in Date</th>
        <th>Move-out Date</th>
        <th>Duration (months)</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% 
         // Helper function to compute the move-out date based on start date and duration
         function computeMoveOut(startDate, duration) {
           const d = new Date(startDate);
           d.setMonth(d.getMonth() + Number(duration));
           return d;
         }
      %>
      <% bookings.forEach(booking => { %>
        <tr>
          <td>
            <% if (booking.property) { %>
              <%= booking.property.title %>
            <% } else { %>
              <span class="text-muted">[Property not available]</span>
            <% } %>
          </td>
          <td><%= booking.fullName %></td>
          <td><%= new Date(booking.startDate).toLocaleDateString() %></td>
          <td><%= computeMoveOut(booking.startDate, booking.durationInMonths).toLocaleDateString() %></td>
          <td><%= booking.durationInMonths %></td>
          <td>
            <% if (booking.status === 'accepted') { %>
              Accepted
            <% } else { %>
              <%= booking.status %>
            <% } %>
          </td>
          <td>
            <% if (booking.status === 'pending') { %>
              <form action="/owner/accept" method="POST" style="display:inline;">
                <input type="hidden" name="bookingId" value="<%= booking._id %>">
                <button type="submit" class="btn btn-primary btn-sm">Proceed</button>
              </form>
            <% } else { %>
              <span class="text-success">Processed</span>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
