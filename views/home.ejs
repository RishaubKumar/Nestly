<!-- Renders the main marketing landing page for the room renting platform Nestly -->

<% layout("/layouts/boilerplate") %>

<style>
  :root {
    --nestly-red: #dc3545;
    --nestly-dark-red: #c82333;
    --nestly-light-red: #f8d7da;
  }

  .hero {
    position: relative;
    height: 60vh;
    display: flex;
    align-items: center;
    background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://plus.unsplash.com/premium_photo-1681149342561-96713cd1728a?w=1200&auto=format&fit=crop&q=60') center/cover no-repeat;
  }

  .about {
    padding: 60px 0;
    background-color: #f8f9fa;
  }

  .feature-card {
    padding: 30px 20px;
    border-radius: 10px;
    margin-bottom: 30px;
    background-color: white;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    border-top: 3px solid var(--nestly-red);
  }

  .feature-icon {
    width: 100px;
    height: 100px;
    object-fit: cover;
  }

  .cta {
    background: linear-gradient(135deg, var(--nestly-red) 0%, var(--nestly-dark-red) 100%);
    padding: 60px 0;
  }
</style>

<header class="hero text-center text-white">
  <div class="container hero-content">
    <h1 class="display-3 fw-bold">Welcome to Nestly</h1>
    <p class="fs-4">Find unique rooms and vacation stays tailored to your budget.</p>
    <a href="/listings" class="btn btn-danger btn-lg mt-3 fw-bold">Find Your Stay</a>
  </div>
</header>

<section class="about">
  <div class="container">
    <h2 class="text-center mb-5 text-danger fw-bold">Why Choose Nestly?</h2>
    <div class="row">
      <div class="col-md-4 mb-4">
        <div class="feature-card text-center">
          <img src="https://www.pixelstalk.net/wp-content/uploads/2016/08/Travel-Download-Free-Images-HD.jpg" alt="Travel" class="feature-icon mb-3 rounded-circle border border-danger p-1">
          <h5 class="text-danger mt-3 fw-bold">Unique Destinations</h5>
          <p class="text-muted">Explore hand-picked rooms and stays designed for comfortable living.</p>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="feature-card text-center">
          <img src="https://th.bing.com/th?q=Customer+Support+Flat+Icons&w=120&h=120&c=1&rs=1&qlt=90&cb=1&pid=InlineBlock&adlt=moderate" alt="Support" class="feature-icon mb-3 rounded-circle border border-danger p-1">
          <h5 class="text-danger mt-3 fw-bold">24/7 Assistance</h5>
          <p class="text-muted">Our support team is always available to resolve your booking issues.</p>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="feature-card text-center">
          <img src="https://th.bing.com/th/id/OIP.6zo0IhNshawEjJ3UxE7tcQHaHa?w=158&h=180&c=7&o=5" alt="Affordable" class="feature-icon mb-3 rounded-circle border border-danger p-1">
          <h5 class="text-danger mt-3 fw-bold">Affordable Rentals</h5>
          <p class="text-muted">Find stays without brokerages or high commercial overhead costs.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="cta text-center text-white">
  <div class="container">
    <h2>Ready to start your journey?</h2>
    <p class="lead mb-4">Book local rooms or list your own property on Nestly today.</p>
    <a href="/listings" class="btn btn-light text-danger btn-lg fw-bold px-4">Browse All Stays</a>
  </div>
</section>