<% layout("/layouts/boilerplate") %>

<!-- Custom CSS for animations and styling -->
<style>
  :root {
    --nestly-red: #dc3545;
    --nestly-dark-red: #c82333;
    --nestly-light-red: #f8d7da;
  }

  /* Animation keyframes */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0px); }
  }

  @keyframes slideInLeft {
    from { opacity: 0; transform: translateX(-50px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(50px); }
    to { opacity: 1; transform: translateX(0); }
  }

  /* General styling */
  body {
    overflow-x: hidden;
    scroll-behavior: smooth;
  }

  .text-shadow {
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }

  .section-title {
    position: relative;
    margin-bottom: 50px;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 3px;
    background-color: var(--nestly-red);
  }

  /* Hero section */
  .hero {
    position: relative;
    height: 80vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url('https://plus.unsplash.com/premium_photo-1681149342561-96713cd1728a?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8NXx8eWVsbG93JTIwdHJhdmVsfGVufDB8fDB8fHww') center/cover no-repeat;
    filter: brightness(0.6);
    z-index: -1;
    transition: transform 0.3s ease;
  }

  .hero-content {
    animation: fadeIn 1.2s ease-out;
  }

  .hero-title {
    font-size: 3.5rem;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1.5rem;
    margin-bottom: 2rem;
  }

  .btn-hero {
    padding: 12px 30px;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 30px;
    animation: pulse 2s infinite;
    transition: all 0.3s ease;
    box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
  }

  .btn-hero:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(220, 53, 69, 0.6);
  }

  /* About section */
  .about {
    padding: 80px 0;
    background-color: #f8f9fa;
  }

  .feature-card {
    padding: 30px 20px;
    border-radius: 10px;
    margin-bottom: 30px;
    transition: all 0.3s ease;
    background-color: white;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
  }

  .feature-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 30px rgba(220, 53, 69, 0.1);
  }

  .feature-icon {
    width: 150px;
    height: 150px;
    object-fit: cover;
    transition: all 0.3s ease;
  }

  .feature-card:hover .feature-icon {
    transform: scale(1.1);
    border-color: var(--nestly-dark-red);
  }



  /* CTA section */
  .cta {
    background: linear-gradient(135deg, var(--nestly-red) 0%, var(--nestly-dark-red) 100%);
    padding: 80px 0;
    position: relative;
    overflow: hidden;
  }

  .cta::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23ffffff' fill-opacity='0.1' fill-rule='evenodd'/%3E%3C/svg%3E") center/cover;
    opacity: 0.2;
  }

  .cta-content {
    position: relative;
    z-index: 1;
  }

  .btn-cta {
    background-color: white;
    color: var(--nestly-red);
    padding: 12px 30px;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 30px;
    transition: all 0.3s ease;
    border: 2px solid white;
  }

  .btn-cta:hover {
    background-color: transparent;
    color: white;
  }



  /* Animation classes */
  .fade-in {
    animation: fadeIn 1s ease-out forwards;
  }

  .slide-in-left {
    animation: slideInLeft 1s ease-out forwards;
  }

  .slide-in-right {
    animation: slideInRight 1s ease-out forwards;
  }

  .floating {
    animation: float 3s ease-in-out infinite;
  }
</style>

<body>
  <!-- Hero Section -->
  <header class="hero">
    <div class="container hero-content text-center text-white">
      <h1 class="hero-title fw-bold text-shadow">Welcome to Nestly</h1>
      <p class="hero-subtitle text-shadow">Your gateway to unforgettable stays and adventures worldwide.</p>
      <a href="/listings" class="btn btn-danger btn-lg btn-hero mt-3">Find Your Stay</a>
    </div>
  </header>

  <!-- About Section -->
  <section class="about py-5">
    <div class="container">
      <h2 class="text-center section-title text-danger">Why Choose Nestly?</h2>
      <div class="row mt-5">
        <!-- Unique Destinations -->
        <div class="col-md-4 mb-4">
          <div class="feature-card text-center reveal-from-left">
            <img src="https://www.pixelstalk.net/wp-content/uploads/2016/08/Travel-Download-Free-Images-HD.jpg" alt="Travel" class="feature-icon mb-3 rounded-circle border border-danger p-2">
            <h5 class="text-danger mt-4">Unique Destinations</h5>
            <p class="text-muted">Explore hidden gems and unique stays tailored for your next adventure.</p>
          </div>
        </div>
        <!-- 24/7 Support -->
        <div class="col-md-4 mb-4">
          <div class="feature-card text-center reveal-from-bottom">
            <img src="https://th.bing.com/th?q=Customer+Support+Flat+Icons&w=120&h=120&c=1&rs=1&qlt=90&cb=1&pid=InlineBlock&mkt=en-IN&cc=IN&setlang=en&adlt=moderate&t=1&mw=247" alt="Support" class="feature-icon mb-3 rounded-circle border border-danger p-2">
            <h5 class="text-danger mt-4">24/7 Support</h5>
            <p class="text-muted">Our team is here to help you anytime, ensuring a hassle-free experience.</p>
          </div>
        </div>
        <!-- Affordable Prices -->
        <div class="col-md-4 mb-4">
          <div class="feature-card text-center reveal-from-right">
            <img src="https://th.bing.com/th/id/OIP.6zo0IhNshawEjJ3UxE7tcQHaHa?w=158&h=180&c=7&r=0&o=5&pid=1.7" alt="Affordable" class="feature-icon mb-3 rounded-circle border border-danger p-2">
            <h5 class="text-danger mt-4">Affordable Prices</h5>
            <p class="text-muted">Get the best deals on stays without compromising quality.</p>
          </div>
        </div>
      </div>
    </div>
  </section>



  <!-- Call to Action -->
  <section class="cta text-center text-white">
    <div class="container cta-content">
      <h2 class="floating">Ready to explore the world?</h2>
      <p class="lead mb-4">Find your perfect stay with Nestly and start your journey today.</p>
      <a href="/listings" class="btn btn-cta btn-lg">Browse Listings</a>
    </div>
  </section>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- Animation Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Parallax effect for hero section
      const hero = document.querySelector('.hero');
      window.addEventListener('scroll', function() {
        const scrollPosition = window.scrollY;
        if (hero) {
          hero.style.backgroundPositionY = scrollPosition * 0.5 + 'px';
        }
      });
      
      // Reveal animations on scroll
      const revealElements = function() {
        const windowHeight = window.innerHeight;
        const revealFromLeft = document.querySelectorAll('.reveal-from-left');
        const revealFromRight = document.querySelectorAll('.reveal-from-right');
        const revealFromBottom = document.querySelectorAll('.reveal-from-bottom');
        
        revealFromLeft.forEach(function(element) {
          const elementTop = element.getBoundingClientRect().top;
          if (elementTop < windowHeight - 100) {
            element.classList.add('slide-in-left');
          }
        });
        
        revealFromRight.forEach(function(element) {
          const elementTop = element.getBoundingClientRect().top;
          if (elementTop < windowHeight - 100) {
            element.classList.add('slide-in-right');
          }
        });
        
        revealFromBottom.forEach(function(element) {
          const elementTop = element.getBoundingClientRect().top;
          if (elementTop < windowHeight - 100) {
            element.classList.add('fade-in');
          }
        });
      };
      
      // Run on page load and scroll
      revealElements();
      window.addEventListener('scroll', revealElements);
      
      // Add floating animation to certain elements
      const floatingElements = document.querySelectorAll('.floating');
      floatingElements.forEach(function(element) {
        element.style.animation = 'float 3s ease-in-out infinite';
      });
    });
  </script>
</body>